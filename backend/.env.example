# ============================================================================
# Moodly backend — EXAMPLE environment file.
#
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# Placeholders only are included here — no real credentials.
# ============================================================================

# --- Database -----------------------------------------------------------------
# Default (local development, no PostgreSQL required):
DATABASE_URL=sqlite:///./moodly_backend.db
# PostgreSQL example (requires a running PostgreSQL server; NOT activated by
# default on this machine — see README "PostgreSQL setup"):
# DATABASE_URL=postgresql+psycopg2://moodly:CHANGE_ME@localhost:5432/moodly

# --- Security -----------------------------------------------------------------
# REQUIRED in production. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_random_64_hex_secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Set to 1 ONLY for local development. When 1 and no email provider is
# configured, password-reset tokens are returned in the API response so the
# flow can be tested without SMTP. MUST be 0 (or unset) in production.
MOODLY_DEV_MODE=1

# --- CORS / network -----------------------------------------------------------
# Comma-separated list of allowed origins. The Flutter app calls the API from
# mobile devices (no browser CORS needed); keep this restrictive anyway.
CORS_ORIGINS=http://localhost:* 

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_ENABLED=1
AI_REQUESTS_PER_MINUTE=15
AUTH_REQUESTS_PER_MINUTE=20

# --- AI provider (Phase 3) ----------------------------------------------------
# WITHOUT these the backend still runs but reports ai_enabled=false and all AI
# endpoints fall back to local rule-based results. NEVER commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
# Optional: self-hosted or proxy OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
